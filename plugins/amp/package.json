{
  "name": "@curl.md/amp",
  "version": "0.0.13",
  "description": "URL to markdown for Amp",
  "bin": {
    "curlmd-amp": "./dist/install.js"
  },
  "contributors": [
    "tmm <t@curl.md>",
    "jxom <j@curl.md>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "plugins/amp"
  },
  "funding": "https://github.com/sponsors/wevm",
  "keywords": [
    "curl.md",
    "amp",
    "markdown"
  ],
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    }
  },
  "files": [
    "dist/**",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsgo --noCheck -p tsconfig.build.json",
    "check:types": "tsgo --noEmit"
  },
  "dependencies": {
    "curl.md": "workspace:*"
  },
  "devDependencies": {
    "@ampcode/plugin": "0.0.0-dev"
  }
}
