{
  "name": "@curl.md/opencode",
  "version": "0.1.1",
  "description": "URL to markdown for OpenCode",
  "contributors": [
    "tmm <t@curl.md>",
    "jxom <j@curl.md>"
  ],
  "funding": "https://github.com/sponsors/wevm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "plugins/opencode"
  },
  "keywords": [
    "curl.md",
    "markdown",
    "opencode"
  ],
  "engines": {
    "opencode": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./server": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./tui": {
      "types": "./tui.ts",
      "default": "./tui.ts"
    }
  },
  "files": [
    "*.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "check:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.4.6",
    "curl.md": "workspace:*"
  }
}
