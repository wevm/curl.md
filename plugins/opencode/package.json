{
  "name": "@curl.md/opencode",
  "version": "0.0.2",
  "description": "curl.md plugin for OpenCode",
  "contributors": [
    "awkweb.eth <t@wevm.dev>",
    "jxom.eth <j@wevm.dev>"
  ],
  "funding": "https://github.com/sponsors/wevm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "plugins/opencode"
  },
  "keywords": [
    "curl.md",
    "markdown",
    "opencode"
  ],
  "engines": {
    "opencode": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./server": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./tui": {
      "types": "./tui.ts",
      "default": "./tui.ts"
    }
  },
  "files": [
    "README.md",
    "server.ts",
    "tui.ts"
  ],
  "type": "module",
  "scripts": {
    "check:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.4.6",
    "curl.md": "workspace:*"
  },
  "devDependencies": {
    "opencode-ai": "1.4.7"
  }
}
