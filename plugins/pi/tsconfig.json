{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "curl.md": ["../../cli/src/exports/index.ts"],
      "curl.md/internal": ["../../cli/src/exports/internal.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "include": ["extensions/**/*.ts", "test/**/*.ts"]
}
