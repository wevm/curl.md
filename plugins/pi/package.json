{
  "name": "@curl.md/pi",
  "version": "0.1.1",
  "description": "URL to markdown for Pi",
  "contributors": [
    "tmm <t@curl.md>",
    "jxom <j@curl.md>"
  ],
  "funding": "https://github.com/sponsors/wevm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "plugins/pi"
  },
  "keywords": [
    "curl.md",
    "markdown",
    "pi",
    "pi-package"
  ],
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "check:types": "tsgo --noEmit"
  },
  "pi": {
    "extensions": [
      "./src"
    ]
  },
  "dependencies": {
    "curl.md": "workspace:*"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": ">=0.65.0",
    "@mariozechner/pi-coding-agent": ">=0.65.0",
    "@mariozechner/pi-tui": ">=0.65.0"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.65.2",
    "@mariozechner/pi-coding-agent": "^0.65.2",
    "@mariozechner/pi-tui": "^0.65.2"
  }
}
