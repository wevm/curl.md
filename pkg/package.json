{
  "name": "curl.md",
  "version": "0.0.9",
  "description": "Fetch any URL as Markdown",
  "scripts": {
    "build": "tsgo --noCheck -p tsconfig.build.json && find ../src -name '*.js' -delete",
    "check:types": "tsgo --noEmit",
    "gen:types": "incur gen"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "pkg"
  },
  "license": "FSL-1.1-MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "curl.md": "./dist/cli/bin.js",
    "curl.md.src": "./src/cli/cli.ts",
    "curlmd": "./dist/cli/bin.js",
    "curlmd.src": "./src/cli/cli.ts",
    "md": "./dist/cli/bin.js",
    "md.src": "./src/cli/cli.ts"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src"
  ],
  "dependencies": {
    "hono": "^4.12.2",
    "incur": "^0.2.0",
    "picocolors": "^1.1.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
