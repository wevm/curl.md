@@ -0,0 +1,26 @@
+import { escapeHtml } from "./utils.js";
+import { parseSegments } from "./new-process-route-tree.js";
+import unmask_on_reload_inline_default from "./unmask-on-reload-inline.js";
+function routePathToRegExpSource(routePath) {
+	if (!routePath || routePath === "/") return "^/$";
+	const segments = parseSegments(false, { fullPath: routePath }, 0);
+	const source = segments.map((segment) => {
+		if (typeof segment === "string") return escapeRegExp(segment);
+		const [kind, , prefix, suffix = ""] = segment;
+		if (kind === 3) return `(?:${escapeRegExp(prefix)}[^/]+${escapeRegExp(suffix)})?`;
+		if (kind === 2) {
+			if (prefix === "/" && !suffix) return "(?:/.*)?";
+			return `${escapeRegExp(prefix)}.*${escapeRegExp(suffix)}`;
+		}
+		return `${escapeRegExp(prefix)}[^/]+${escapeRegExp(suffix)}`;
+	}).join("");
+	return `^${source}$`;
+}
+function escapeRegExp(value) {
+	return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+function getUnmaskOnReloadScript(routeMaskSources) {
+	if (!routeMaskSources.length) return null;
+	return `(${unmask_on_reload_inline_default})(${escapeHtml(JSON.stringify({ routeMaskSources }))})`;
+}
+export { getUnmaskOnReloadScript, routePathToRegExpSource };
