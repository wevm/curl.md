{
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dist/client"
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "local",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/curl_dev"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "local" }],
  "queues": {
    "producers": [{ "binding": "REQUEST_QUEUE", "queue": "test-queue" }]
  }
}
