{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreWorkspaces": ["."],
  "workspaces": {
    "packages/cli": {
      "entry": ["src/bin.ts"]
    },
    "packages/curl.md": {
      "ignoreDependencies": ["@curl.md/cli"]
    }
  },
  "ignore": ["**/*.test.ts", "**/test/**"],
