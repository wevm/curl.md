{
  "$schema": "../node_modules/knip/schema.json",
  "exclude": ["binaries", "catalog", "duplicates", "exports", "unlisted"],
  "ignoreWorkspaces": ["."],
  "workspaces": {
    "cli": {
      "entry": ["src/bin.ts", "src/exports/index.ts", "src/exports/internal.ts"],
      "ignore": ["**/*.test.ts", "**/*.test-d.ts", "**/test/**"],
      "ignoreDependencies": ["bun"]
    },
    "plugins/*": {
      "ignore": ["**/*.test.ts"]
    },
    "plugins/amp": {
      "entry": ["src/install.ts"],
      "ignore": ["**/*.test.ts"]
    },
    "plugins/claude": {
      "entry": ["scripts/sync.ts", "src/server.ts"],
      "ignore": ["**/*.test.ts"],
      "ignoreDependencies": ["@anthropic-ai/claude-code"]
    },
    "plugins/opencode": {
      "ignore": ["**/*.test.ts"]
    },
    "plugins/pi": {
      "ignore": ["**/*.test.ts", "test/**"]
    }
  }
}
