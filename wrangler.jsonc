{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curl",
  "main": "src/entry-server.ts",
  "compatibility_date": "2025-10-30",
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "assets": {
    "binding": "ASSETS",
  },
  "upload_source_maps": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "preview_urls": false,
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "96d641bd374842d784a128d7de0428af",
      "localConnectionString": "postgresql://postgres:postgres@db.curl.local:5432/curl_dev",
    },
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "e3a921b8d13741b99e7aa1cbb6144c9f" }],
  "queues": {
    "producers": [
      { "binding": "REQUEST_ENRICH_QUEUE", "queue": "curl-request-enrichment" },
      { "binding": "REQUEST_QUEUE", "queue": "curl-request" },
      { "binding": "STRIPE_WEBHOOK_QUEUE", "queue": "curl-stripe-webhook" },
    ],
    "consumers": [
      {
        "queue": "curl-request-enrichment",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "curl-request-enrichment-dlq",
      },
      {
        "queue": "curl-request",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "curl-request-dlq",
      },
      {
        "queue": "curl-stripe-webhook",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "curl-stripe-webhook-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "secrets": {
    "required": [
      "COOKIE_SECRET",
      "GH_CLIENT_ID",
      "GH_CLIENT_SECRET",
      "SENTRY_DSN",
      "STRIPE_PUBLISHABLE_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "TOKEN_ENCRYPTION_KEY",
    ],
  },
  "vars": {
    "GH_API_URL": "https://api.github.com",
    "GH_URL": "https://github.com",
    "HOST": "curl.local",
    "STRIPE_API_URL": "https://api.stripe.com",
  },
  "env": {
    "production": {
      "name": "curl",
      "observability": {
        "enabled": true,
        "logs": {
          "head_sampling_rate": 1,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
      "assets": {
        "binding": "ASSETS",
      },
      "ai": {
        "binding": "AI",
      },
      "hyperdrive": [
        {
          "binding": "DB",
          "id": "96d641bd374842d784a128d7de0428af",
        },
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "e3a921b8d13741b99e7aa1cbb6144c9f" }],
      "queues": {
        "producers": [
          { "binding": "REQUEST_ENRICH_QUEUE", "queue": "curl-request-enrichment" },
          { "binding": "REQUEST_QUEUE", "queue": "curl-request" },
          { "binding": "STRIPE_WEBHOOK_QUEUE", "queue": "curl-stripe-webhook" },
        ],
        "consumers": [
          {
            "queue": "curl-request-enrichment",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "curl-request-enrichment-dlq",
          },
          {
            "queue": "curl-request",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "curl-request-dlq",
          },
          {
            "queue": "curl-stripe-webhook",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "curl-stripe-webhook-dlq",
          },
        ],
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "secrets": {
        "required": [
          "COOKIE_SECRET",
          "GH_CLIENT_ID",
          "GH_CLIENT_SECRET",
          "SENTRY_DSN",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "TOKEN_ENCRYPTION_KEY",
        ],
      },
      "vars": {
        "GH_API_URL": "https://api.github.com",
        "GH_URL": "https://github.com",
        "HOST": "curl.md",
        "STRIPE_API_URL": "https://api.stripe.com",
      },
      "routes": [{ "pattern": "curl.md", "custom_domain": true }],
      "triggers": {
        "crons": ["0 * * * *"],
      },
    },
    "preview": {
      "name": "__PREVIEW_NAME__",
      "observability": {
        "enabled": true,
        "logs": {
          "head_sampling_rate": 1,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
        },
      },
      "assets": {
        "binding": "ASSETS",
      },
      "ai": {
        "binding": "AI",
      },
      "hyperdrive": [
        {
          "binding": "DB",
          "id": "__PREVIEW_HYPERDRIVE_ID__",
        },
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "__PREVIEW_KV_ID__" }],
      "queues": {
        "producers": [
          {
            "binding": "REQUEST_ENRICH_QUEUE",
            "queue": "curl-request-enrichment-__PREVIEW_APEX__",
          },
          {
            "binding": "REQUEST_QUEUE",
            "queue": "curl-request-__PREVIEW_APEX__",
          },
          {
            "binding": "STRIPE_WEBHOOK_QUEUE",
            "queue": "curl-stripe-webhook-__PREVIEW_APEX__",
          },
        ],
        "consumers": [
          {
            "queue": "curl-request-enrichment-__PREVIEW_APEX__",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "curl-request-enrichment-__PREVIEW_APEX__-dlq",
          },
          {
            "queue": "curl-request-__PREVIEW_APEX__",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "curl-request-__PREVIEW_APEX__-dlq",
          },
          {
            "queue": "curl-stripe-webhook-__PREVIEW_APEX__",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "curl-stripe-webhook-__PREVIEW_APEX__-dlq",
          },
        ],
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "secrets": {
        "required": [
          "COOKIE_SECRET",
          "GH_CLIENT_ID",
          "GH_CLIENT_SECRET",
          "SENTRY_DSN",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "TOKEN_ENCRYPTION_KEY",
        ],
      },
      "vars": {
        "GH_API_URL": "https://api.github.com",
        "GH_URL": "https://github.com",
        "HOST": "__PREVIEW_APEX__.curl.md",
        "STRIPE_API_URL": "https://api.stripe.com",
      },
      "routes": [{ "pattern": "__PREVIEW_APEX__.curl.md", "custom_domain": true }],
      "triggers": {
        "crons": ["0 * * * *"],
      },
    },
  },
}
