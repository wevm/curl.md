{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curl",
  "main": "src/entry-server.ts",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "curl-db", "database_id": "local" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "local" }],
  "queues": {
    "producers": [{ "binding": "TOKEN_UPDATE_QUEUE", "queue": "curl-tokens" }],
    "consumers": [
      {
        "queue": "curl-tokens",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3
      }
    ]
  },
  "vars": {
    "HOST": "curl.local"
  },
  "env": {
    "production": {
      "name": "curl",
      "observability": {
        "enabled": true,
        "logs": {
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01
        }
      },
      "assets": {
        "binding": "ASSETS"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "curl-db",
          "database_id": "effd0dcd-c90e-4449-9ccc-ec920da05e04"
        }
      ],
      "kv_namespaces": [
        { "binding": "KV", "id": "e3a921b8d13741b99e7aa1cbb6144c9f" }
      ],
      "queues": {
        "producers": [
          { "binding": "TOKEN_UPDATE_QUEUE", "queue": "curl-tokens" }
        ],
        "consumers": [
          {
            "queue": "curl-tokens",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3
          }
        ]
      },
      "vars": {
        "HOST": "curl.md"
      },
      "routes": [{ "pattern": "curl.md", "custom_domain": true }]
    },
    "preview": {
      "name": "__PREVIEW_NAME__",
      "assets": {
        "binding": "ASSETS"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "__PREVIEW_DB_NAME__",
          "database_id": "__PREVIEW_DB_ID__"
        }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "__PREVIEW_KV_ID__" }],
      "queues": {
        "producers": [
          {
            "binding": "TOKEN_UPDATE_QUEUE",
            "queue": "curl-tokens-__PREVIEW_APEX__"
          }
        ],
        "consumers": [
          {
            "queue": "curl-tokens-__PREVIEW_APEX__",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3
          }
        ]
      },
      "vars": {
        "HOST": "__PREVIEW_APEX__.curl.md"
      },
      "routes": [
        { "pattern": "__PREVIEW_APEX__.curl.md", "custom_domain": true }
      ]
    }
  }
}
