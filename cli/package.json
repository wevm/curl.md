{
  "name": "curl.md",
  "version": "0.0.14",
  "description": "URL to markdown for agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "cli"
  },
  "bin": {
    "curl.md": "./dist/bin.js",
    "curl.md.src": "./src/cli.ts",
    "curlmd": "./dist/bin.js",
    "curlmd.src": "./src/cli.ts",
    "md": "./dist/bin.js",
    "md.src": "./src/cli.ts"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#db/*": "../db/*",
    "#*": "../src/*",
    "#test/*": "../test/*"
  },
  "scripts": {
    "build": "tsgo --noCheck -p tsconfig.build.json && find ../src ../db -name '*.js' -delete",
    "check:deps": "knip",
    "check:types": "tsgo --noEmit",
    "gen:types": "incur gen"
  },
  "dependencies": {
    "hono": "catalog:",
    "incur": "0.3.25",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "bun": "^1.3.10",
    "knip": "^6.0.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
