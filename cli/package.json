{
  "name": "curl.md",
  "version": "0.0.14",
  "description": "URL to markdown for agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "cli"
  },
  "bin": {
    "curl.md": "./dist/bin.js",
    "curl.md.src": "./src/cli.ts",
    "curlmd": "./dist/bin.js",
    "curlmd.src": "./src/cli.ts",
    "md": "./dist/bin.js",
    "md.src": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    },
    "./internal": {
      "types": "./dist/exports/internal.d.ts",
      "default": "./dist/exports/internal.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "types": "./dist/exports/index.d.ts",
  "imports": {
    "#db/*": {
      "types": "./dist/db/*",
      "default": "../db/*"
    },
    "#*": {
      "types": "./dist/src/*",
      "default": "../src/*"
    },
    "#test/*": "../test/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsgo --noCheck -p tsconfig.build.json && tsgo --noCheck -p tsconfig.pkg.json && mkdir -p dist/exports dist/cli/src && cp dist/cli/src/exports/index.d.ts dist/exports/index.d.ts && cp dist/cli/src/exports/internal.d.ts dist/exports/internal.d.ts && cp src/cf-env.d.ts dist/cli/src/cf-env.d.ts && find ../src ../db -name '*.js' -delete",
    "check:deps": "knip",
    "check:types": "tsgo --noEmit",
    "gen:types": "incur gen"
  },
  "dependencies": {
    "hono": "catalog:",
    "incur": "0.3.25",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "bun": "^1.3.10",
    "knip": "^6.0.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
