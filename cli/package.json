{
  "name": "curl.md",
  "version": "0.0.1",
  "description": "Fetch any URL as Markdown",
  "scripts": {
    "build": "tsgo --noCheck -p tsconfig.build.json && find ../src -name '*.js' -delete",
    "check:types": "tsgo --noEmit",
    "gen:types": "incur gen"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "curl.md": "./dist/bin.js",
    "curl.md.src": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "hono": "^4.12.2",
    "incur": "^0.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
