{
  "name": "curl.md",
  "version": "0.1.2",
  "description": "URL to markdown for agents",
  "contributors": [
    "tmm <t@curl.md>",
    "jxom <j@curl.md>"
  ],
  "funding": "https://github.com/sponsors/wevm",
  "keywords": [
    "curl.md",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/curl.md.git",
    "directory": "cli"
  },
  "bin": {
    "curl.md": "./dist/bin.js",
    "curl.md.src": "./src/cli.ts",
    "curlmd": "./dist/bin.js",
    "curlmd.src": "./src/cli.ts",
    "md": "./dist/bin.js",
    "md.src": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    },
    "./internal": {
      "types": "./dist/exports/internal.d.ts",
      "default": "./dist/exports/internal.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src/cf-env.d.ts",
    "src/shims.d.ts"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/exports/index.d.ts",
  "imports": {
    "#api.ts": {
      "types": "./dist/src/api.ts",
      "default": "./dist/src/api.ts"
    },
    "#db/client.ts": {
      "types": "./dist/db/client.ts",
      "default": "./dist/db/client.ts"
    },
    "#db/*.ts": {
      "types": "./dist/db/*.ts",
      "default": "./dist/db/*.ts"
    },
    "#db/*": {
      "types": "./dist/db/*",
      "default": "./dist/db/*"
    },
    "#*.ts": {
      "types": "./dist/src/*.ts",
      "default": "./dist/src/*.ts"
    },
    "#*.tsx": {
      "types": "./dist/src/*.tsx",
      "default": "./dist/src/*.tsx"
    },
    "#*": {
      "types": "./dist/src/*",
      "default": "./dist/src/*"
    },
    "#test/*": "../test/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsgo --noCheck -p tsconfig.build.json && tsgo --noCheck -p tsconfig.pkg.json && tsgo --noCheck -p tsconfig.pkg.api.json && find ../src ../db -name '*.js' -delete",
    "check:types": "tsgo --noEmit",
    "gen:types": "incur gen"
  },
  "dependencies": {
    "hono": "catalog:",
    "incur": "0.4.11",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "bun": "^1.3.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
