{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "paths": {
      "curl.md": ["./src/index.ts"],
      "curl.md/internal": ["./src/internal/index.ts"],
      "#*": ["./../src/*"],
      "#db/*": ["./../db/*"],
      "#test/*": ["./../test/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "include": ["src", "test"]
}
