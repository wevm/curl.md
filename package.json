{
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "biome check .",
    "check:types": "tsgo -b",
    "db": "sqlite3 $(find .wrangler -name '*.sqlite' -path '*/d1/*' | head -1)",
    "db:codegen": "node --experimental-strip-types scripts/db-codegen.ts",
    "db:command": "wrangler d1 execute curl-db --local --command",
    "db:migrate": "wrangler d1 migrations apply curl-db --local",
    "deploy": "pnpm run build && wrangler deploy",
    "deps": "pnpx taze",
    "deps:ci": "pnpx actions-up",
    "dev": "vite dev --port 3000",
    "gen:types": "cp -n .env.example .env 2>/dev/null; wrangler types src/worker-configuration.d.ts",
    "preinstall": "pnpx only-allow pnpm",
    "prepare": "pnpm gen:types && simple-git-hooks",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run --config test/vitest.config.ts",
    "test:eval": "NODE_TLS_REJECT_UNAUTHORIZED=0 evalite"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.4",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "kysely": "^0.28.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "workers-og": "^0.0.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@iconify-json/lucide": "^1.2.91",
    "@iconify-json/octicon": "^1.2.21",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260216.1",
    "@vitejs/plugin-react": "^5.0.4",
    "evalite": "1.0.0-beta.16",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "tiny-jsonc": "^1.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.1.7",
    "vitest": "^4.0.18",
    "wrangler": "^4.68.0"
  },
  "packageManager": "pnpm@10.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.5.1",
      "onFail": "download"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --write --staged --no-errors-on-unmatched && git update-index --again"
  }
}
