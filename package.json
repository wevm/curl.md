{
  "name": "root",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "build:cli": "tsgo -p cli",
    "curl": "CURL_MD_BASE_URL=https://curl.local NODE_TLS_REJECT_UNAUTHORIZED=0 node --experimental-strip-types --no-warnings cli/src/cli.ts",
    "check": "biome check .",
    "check:types": "tsgo -b",
    "db": "sqlite3 $(find .wrangler -name '*.sqlite' -path '*/d1/*' | head -1)",
    "db:codegen": "node --experimental-strip-types scripts/db-codegen.ts",
    "db:command": "wrangler d1 execute curl-db --local --command",
    "db:migrate": "wrangler d1 migrations apply curl-db --local",
    "deploy": "pnpm run build && wrangler deploy",
    "deps": "pnpx taze -r --no-ignore-other-workspaces --ignore-paths node_modules",
    "deps:ci": "pnpx actions-up --dir .github --dir pro/.github",
    "dev": "vite dev --port 3000",
    "gen:types": "cp -n .env.example .env 2>/dev/null; wrangler types src/worker-configuration.d.ts",
    "preinstall": "pnpx only-allow pnpm",
    "prepare": "pnpm gen:types && simple-git-hooks",
    "preview": "pnpm run build && vite preview",
    "test": "vitest",
    "test:pro": "pnpm --filter pro test"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.4",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@modelcontextprotocol/sdk": "catalog:",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "kysely": "^0.28.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-parse": "catalog:",
    "rehype-remark": "catalog:",
    "remark-gfm": "catalog:",
    "remark-stringify": "catalog:",
    "unified": "catalog:",
    "vfile": "catalog:",
    "workers-og": "^0.0.27",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^2.29.8",
    "@iconify-json/lucide": "^1.2.91",
    "@iconify-json/octicon": "^1.2.21",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "tiny-jsonc": "^1.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.1.7",
    "vitest": "^4.0.18",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@10.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.5.1",
      "onFail": "download"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --write --unsafe --staged --no-errors-on-unmatched && git update-index --again"
  }
}
